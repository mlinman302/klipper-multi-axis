# Tests for RTCP compensation on a B axis tilting head
DICTIONARY atmega2560.dict
CONFIG multi_axis_rtcp.cfg

# Home everything.  Homing runs in the carriage frame and G28 refuses to
# run with compensation on, so turn it off across the homes.  B is at
# zero here, where the two frames coincide and toggling is a no-op.
SET_RTCP ENABLE=0
G28 X Y Z
G28 B
SET_RTCP ENABLE=1

G1 X50 Y50 Z20 F3000

# Tilt in place.  The tip is commanded to stay put, so the X and Z
# carriages must move to compensate.
G1 B15 F600
G1 B30 F600
G1 B45 F600
G1 B0 F600
G1 B-45 F600
G1 B0 F600

# Tilt while moving the tip
G1 X80 B30 F3000
G1 X50 Z40 B-30 F3000
G1 X60 Y60 Z30 B0 F3000

# Tilted printing moves
G1 B20 F600
G1 X70 Y70 E1 F1500
G1 X80 Y70 E2 F1500
G1 X80 Y80 E3 F1500
G1 B0 F600

# Position reporting is in the tool tip frame
G1 X50 Y50 Z20 B25 F3000
GET_POSITION
M114

# Turning RTCP off leaves the machine where it is and stops compensating
SET_RTCP ENABLE=0
G1 B0 F600
G1 X55 F3000
SET_RTCP ENABLE=1
G1 X50 F3000

# Retune the tool geometry at runtime
SET_RTCP VERTICAL_OFFSET=42.5
G1 B10 F600
SET_RTCP VERTICAL_OFFSET=40.0
G1 B0 F600

# Re-home from a tilted, compensated state.  Turning RTCP off does not
# move the machine, it just hands the carriage position back, which is
# the frame the homes then run in.
G1 B30 F600
SET_RTCP ENABLE=0
G28 X Y Z
G28 B
SET_RTCP ENABLE=1

M84
