# Tests for the bed-frame interpretation of the B axis - a commanded B
# is a lean toward the bed's +x, and the machine gets its projection
# onto the plane the head can actually tilt in
DICTIONARY atmega2560.dict
CONFIG multi_axis_bproject.cfg

# Report the geometry before anything moves
RTCP_PROBE_INFO

# Homing, probing and orienting run in the machine frame, so both
# transforms are off for them: the park angle (-90) and the probing
# angle (45) are machine angles, and the projection would scale each of
# them by whatever bed angle happened to be under the arm.
SET_RTCP ENABLE=0
SET_B_PROJECTION ENABLE=0
G28 X
G28 B
RTCP_PROBE_ORIENT MODE=PROBE
RTCP_PROBE_MOVE X=25 Y=0 F=50
G28 Z
RTCP_PROBE_ORIENT MODE=TOOL
SET_B_PROJECTION RESTORE=1
SET_RTCP ENABLE=1

# Hold B while the bed turns underneath.  The commanded B stays at 10
# but the machine's B sweeps 10 -> 0 -> -10 -> 0 -> 10 as the arm goes
# round the bed, so both gantry motors move on every one of these.
G1 Z10 F300
G1 X30 Y0 F3000
G1 B10 F600
G1 X0 Y30 F3000
G1 X-30 Y0 F3000
G1 X0 Y-30 F3000
G1 X30 Y0 F3000

# A B move at a bed angle where the projection is at its strongest,
# and at one where it flattens the lean away entirely
G1 B-10 F600
G1 B0 F600
G1 X0 Y30 F3000
G1 B10 F600
G1 B-10 F600
G1 B0 F600

# Sweep the whole B range at a fixed bed angle.  The scaling is the same
# at every one of these: there is no threshold at which the projection
# stops, so no small g-code step becomes a large machine one.
G1 X20 Y20 F3000
G1 B20 F600
G1 B35 F600
G1 B40 F600
G1 B45 F600
G1 B50 F600
G1 B40 F600
G1 B0 F600

# Printing with a held lean while the bed turns
G1 X20 Y0 Z0.3 F1500
G1 B15 F600
G1 X0 Y20 E1 F1500
G1 X-20 Y0 E2 F1500
G1 X0 Y-20 E3 F1500
G1 B0 F600

# Toggling the transform re-syncs the toolhead to where it now is
G1 X0 Y20 F3000
G1 B10 F600
G1 B0 F600
SET_B_PROJECTION ENABLE=0
G1 B10 F600
G1 B0 F600
SET_B_PROJECTION ENABLE=1

GET_POSITION
M114
M84
